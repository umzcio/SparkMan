# SparkMan settings for the systemd service (~/.config/sparkman/sparkman.env).
# Restart after editing:  systemctl --user restart sparkman

# Tailscale logins allowed in (comma-separated). Empty = only requests made on this host itself,
# or any tailnet login once username/password sign-in is on (/etc/sparkman/users.json).
SPARKMAN_ALLOWED_USERS=

# Extra hostnames to accept besides localhost and *.ts.net (e.g. a custom tailnet domain).
SPARKMAN_ALLOWED_HOSTS=

# 1 = offer Claude "Bypass" and Codex "Full access" (no approvals at all). Leave 0 unless you mean it.
SPARKMAN_ALLOW_BYPASS=0

# Loopback only; publish with `tailscale serve`.
SPARKMAN_PORT=4100

# Where new Claude/Codex sessions start, and where SparkMan keeps their history.
SPARKMAN_AGENT_CWD=
SPARKMAN_DATA_DIR=

# Optional overrides.
# SPARKMAN_AGENT_MODE=default
# SPARKMAN_AGENT_MODEL=
# SPARKMAN_CODEX_BIN=/home/you/.local/bin/codex
# SPARKMAN_CODEX_MODEL=
# SPARKMAN_CODEX=0   # hide the Codex page

# ---- live fleet (phase 2) ----
# SPARKMAN_FLEET_CONFIG=/etc/sparkman/fleet.json
# SPARKMAN_FLEET_DB_DIR=/var/lib/sparkman
# Directory (e.g. an NFS mount) for logs older than a week:
# SPARKMAN_LOG_ARCHIVE=
# 1 = rollouts really install updates and reboot (default: dry run)
# SPARKMAN_ROLLOUT_APPLY=0
# tool-eval-bench for the Tool Eval bench, run as an unprivileged account:
# SPARKMAN_TOOL_EVAL_BIN=/opt/tool-eval-bench/bin/tool-eval-bench
# SPARKMAN_TOOL_EVAL_USER=
